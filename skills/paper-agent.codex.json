{
  "name": "paper-agent",
  "version": "1.0.0",
  "description": "Interactive academic paper writing and LaTeX CV/resume generation assistant",
  "author": "paperAgent Team",
  "license": "MIT",
  "triggers": [
    "write a paper",
    "write paper",
    "academic paper",
    "research paper",
    "conference paper",
    "journal paper",
    "thesis",
    "dissertation",
    "course paper",
    "technical report",
    "survey paper",
    "review article",
    "research proposal",
    "create CV",
    "make CV",
    "resume",
    "academic CV",
    "LaTeX CV",
    "Overleaf CV",
    "curriculum vitae",
    "cover letter",
    "literature review",
    "collect references",
    "draft paper",
    "revise paper",
    "reduce AIGC",
    "paraphrase paper"
  ],
  "tools": [
    {
      "name": "init_paper_project",
      "type": "script",
      "path": "../script/init_paper_project.ps1",
      "description": "Initialize a new paper project folder with standard structure",
      "parameters": {
        "topic": "string",
        "paper_type": "string",
        "output_language": "string"
      }
    },
    {
      "name": "init_cv_project",
      "type": "script",
      "path": "../script/init_cv_project.py",
      "description": "Initialize a new CV/resume project folder with standard structure",
      "parameters": {
        "target_use": "string",
        "output_language": "string",
        "template_style": "string"
      }
    },
    {
      "name": "build_search_queries",
      "type": "script",
      "path": "../script/build_search_queries.py",
      "description": "Generate literature search queries from topic and keywords",
      "parameters": {
        "topic": "string",
        "subproblems": "array",
        "keywords": "array"
      }
    },
    {
      "name": "export_final_docx",
      "type": "script",
      "path": "../script/export_final_docx.py",
      "description": "Export manuscript markdown to formatted DOCX file",
      "parameters": {
        "input_md": "string",
        "output_docx": "string"
      }
    },
    {
      "name": "compile_latex_cv",
      "type": "script",
      "path": "../script/compile_latex_cv.ps1",
      "description": "Compile LaTeX CV source to PDF",
      "parameters": {
        "input_tex": "string",
        "output_pdf": "string"
      }
    },
    {
      "name": "open_chrome_search",
      "type": "script",
      "path": "../script/open_chrome_search.ps1",
      "description": "Open Chrome browser for literature search",
      "parameters": {
        "queries": "array",
        "sources": "array"
      }
    }
  ],
  "commands": [
    {
      "name": "start_paper_task",
      "description": "Start a new interactive paper writing session",
      "handler": "guided_intake",
      "required_inputs": ["topic"],
      "optional_inputs": ["paper_type", "output_language", "expected_length", "deadline"]
    },
    {
      "name": "start_cv_task",
      "description": "Start a new interactive CV/resume creation session",
      "handler": "cv_intake",
      "required_inputs": ["target_use"],
      "optional_inputs": ["output_language", "page_length", "template_style", "include_photo"]
    },
    {
      "name": "collect_literature",
      "description": "Search and collect authoritative references for the paper topic",
      "handler": "literature_search",
      "required_inputs": ["topic", "keywords"],
      "optional_inputs": ["subproblems", "exclusions", "source_priority"]
    },
    {
      "name": "build_outline",
      "description": "Create a defensible paper outline based on collected evidence",
      "handler": "outline_generation",
      "required_inputs": ["brief", "references"],
      "optional_inputs": ["paper_type", "contribution_angle"]
    },
    {
      "name": "draft_paper",
      "description": "Draft the full paper in original language",
      "handler": "paper_drafting",
      "required_inputs": ["outline", "references", "output_language"],
      "optional_inputs": ["writing_style", "section_priorities"]
    },
    {
      "name": "revise_paper",
      "description": "Revise paper to reduce repetition and AIGC-like phrasing",
      "handler": "paper_revision",
      "required_inputs": ["draft"],
      "optional_inputs": ["focus_sections", "revision_goals"]
    },
    {
      "name": "export_manuscript",
      "description": "Export final manuscript to DOCX format",
      "handler": "docx_export",
      "required_inputs": ["draft_md"],
      "optional_inputs": ["formatting_options"]
    },
    {
      "name": "generate_cv_content",
      "description": "Convert raw background material into CV content bullets",
      "handler": "cv_content_generation",
      "required_inputs": ["raw_material", "target_use"],
      "optional_inputs": ["emphasis_areas", "metrics"]
    },
    {
      "name": "write_latex_cv",
      "description": "Write or edit LaTeX CV source file",
      "handler": "latex_cv_writing",
      "required_inputs": ["cv_md", "template_style"],
      "optional_inputs": ["include_photo", "photo_path", "bilingual"]
    },
    {
      "name": "compile_cv_pdf",
      "description": "Compile LaTeX CV to PDF",
      "handler": "pdf_compilation",
      "required_inputs": ["cv_tex"],
      "optional_inputs": ["engine", "output_path"]
    }
  ],
  "workflows": {
    "paper_writing": {
      "stages": [
        {
          "id": 1,
          "name": "initialize",
          "action": "init_paper_project",
          "outputs": ["intake.md", "brief.md"]
        },
        {
          "id": 2,
          "name": "guided_intake",
          "action": "guided_intake",
          "max_question_batches": 3,
          "questions_per_batch": {"min": 2, "max": 4},
          "outputs": ["intake.md", "brief.md"]
        },
        {
          "id": 3,
          "name": "search_planning",
          "action": "build_search_queries",
          "prerequisites": ["brief.md"],
          "outputs": ["search_plan.md"]
        },
        {
          "id": 4,
          "name": "literature_collection",
          "action": "collect_literature",
          "prerequisites": ["search_plan.md"],
          "outputs": ["notes.md", "references.md"]
        },
        {
          "id": 5,
          "name": "argument_building",
          "action": "build_outline",
          "prerequisites": ["references.md"],
          "outputs": ["outline.md"]
        },
        {
          "id": 6,
          "name": "drafting",
          "action": "draft_paper",
          "prerequisites": ["outline.md", "references.md"],
          "outputs": ["draft.md"]
        },
        {
          "id": 7,
          "name": "revision",
          "action": "revise_paper",
          "prerequisites": ["draft.md"],
          "outputs": ["draft.md", "revision_log.md"]
        },
        {
          "id": 8,
          "name": "finalization",
          "action": "export_manuscript",
          "prerequisites": ["draft.md", "references.md"],
          "outputs": ["final-manuscript.docx"]
        }
      ],
      "stage_gates": [
        {"after": 2, "check": "brief_confirmed"},
        {"after": 4, "check": "angle_defined"},
        {"after": 5, "check": "outline_confirmed"}
      ]
    },
    "cv_generation": {
      "stages": [
        {
          "id": 1,
          "name": "initialize",
          "action": "init_cv_project",
          "outputs": ["intake.md", "brief.md"]
        },
        {
          "id": 2,
          "name": "cv_intake",
          "action": "cv_intake",
          "max_question_batches": 2,
          "questions_per_batch": {"min": 3, "max": 6},
          "outputs": ["intake.md", "brief.md", "cv-data.md"]
        },
        {
          "id": 3,
          "name": "style_selection",
          "action": "select_cv_template",
          "prerequisites": ["brief.md"],
          "outputs": ["template_choice.md"]
        },
        {
          "id": 4,
          "name": "content_conversion",
          "action": "generate_cv_content",
          "prerequisites": ["cv-data.md", "template_choice.md"],
          "outputs": ["cv.md"]
        },
        {
          "id": 5,
          "name": "latex_writing",
          "action": "write_latex_cv",
          "prerequisites": ["cv.md"],
          "outputs": ["cv.tex"]
        },
        {
          "id": 6,
          "name": "compilation",
          "action": "compile_cv_pdf",
          "prerequisites": ["cv.tex"],
          "outputs": ["final-cv.pdf"]
        }
      ]
    }
  },
  "schemas": {
    "paper_intake": {
      "type": "object",
      "properties": {
        "topic": {"type": "string", "required": true},
        "paper_type": {
          "type": "string",
          "enum": ["degree_thesis", "course_paper", "technical_report", "journal_paper", "conference_paper", "survey_review", "research_proposal"],
          "required": true
        },
        "output_language": {"type": "string", "enum": ["chinese", "english", "bilingual"], "required": true},
        "expected_length": {"type": "string"},
        "deadline": {"type": "string"},
        "target_venue": {"type": "string"},
        "must_include": {"type": "array", "items": {"type": "string"}},
        "must_avoid": {"type": "array", "items": {"type": "string"}},
        "existing_materials": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cv_intake": {
      "type": "object",
      "properties": {
        "target_use": {
          "type": "string",
          "enum": ["academic_cv", "research_internship", "industry_resume", "scholarship_application", "general_profile"],
          "required": true
        },
        "output_language": {"type": "string", "enum": ["chinese", "english", "bilingual"], "required": true},
        "page_length": {"type": "string", "enum": ["one_page", "two_pages", "complete_cv"]},
        "template_style": {"type": "string", "enum": ["classic", "compact", "modern", "academic", "agent_choice"]},
        "include_photo": {"type": "boolean"},
        "photo_path": {"type": "string"},
        "ats_friendly": {"type": "boolean"},
        "target_field": {"type": "string"},
        "target_role": {"type": "string"},
        "existing_materials": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reference_entry": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "required": true},
        "authors": {"type": "array", "items": {"type": "string"}},
        "venue": {"type": "string"},
        "year": {"type": "integer"},
        "doi": {"type": "string"},
        "url": {"type": "string"},
        "source_type": {"type": "string", "enum": ["peer_reviewed", "preprint", "official_docs", "technical_blog", "news"]},
        "relevance_notes": {"type": "string"}
      }
    }
  },
  "policies": {
    "evidence_priority": [
      "peer_reviewed_papers",
      "credible_preprints",
      "official_documentation",
      "strong_technical_blogs",
      "news_marketing"
    ],
    "prohibited_actions": [
      "fabricate_citations",
      "fabricate_doi",
      "fabricate_experimental_results",
      "fabricate_venue_rankings",
      "invent_user_background",
      "copy_overleaf_template_verbatim"
    ],
    "uncertainty_markers": [
      "tentative_inference",
      "open_question",
      "hypothesis",
      "TODO"
    ],
    "language_policy": {
      "rule": "Fix output language early in intake",
      "defaults": {
        "explicit_request": "follow user request",
        "implied_by_context": "follow context",
        "ambiguous": "ask directly"
      }
    }
  },
  "file_conventions": {
    "paper_project": {
      "directory": "papers/{topic_slug}",
      "required_files": [
        "intake.md",
        "brief.md",
        "outline.md",
        "draft.md",
        "final-manuscript.docx",
        "references.md",
        "notes.md"
      ],
      "optional_files": [
        "search_plan.md",
        "revision_log.md",
        "figures/",
        "supplementary/"
      ]
    },
    "cv_project": {
      "directory": "cvs/{person_target_slug}",
      "required_files": [
        "intake.md",
        "brief.md",
        "cv-data.md",
        "cv.md",
        "cv.tex",
        "notes.md"
      ],
      "optional_files": [
        "final-cv.pdf",
        "cover-letter.tex",
        "publications.bib",
        "resume-ats.tex",
        "profile-photo.jpg",
        "profile-photo.png"
      ]
    }
  },
  "interactive_guidelines": {
    "question_budget": {
      "first_batch": {"min": 2, "max": 4},
      "later_batches": {"min": 1, "max": 3}
    },
    "priority_unknowns": [
      "exact_problem_or_subproblem",
      "paper_type",
      "output_language",
      "output_constraints",
      "existing_ideas_or_references"
    ],
    "conversation_style": [
      "concise",
      "specific",
      "purpose_driven",
      "easy_to_answer"
    ],
    "anti_patterns": [
      "long_enumerations_without_prioritization",
      "abstract_unanswerable_questions",
      "irrelevant_details",
      "rigid_questionnaire_dumping"
    ],
    "adaptive_follow_up": {
      "degree_thesis": ["degree_level", "institution_requirements", "chapter_depth", "expected_contribution"],
      "course_paper": ["course_name", "teacher_rubric", "length", "novelty_required"],
      "technical_document": ["target_reader", "engineering_purpose", "system_boundary", "formal_citations_needed"],
      "journal_conference_paper": ["target_venue", "contribution_claim", "experiment_requirement", "deadline"]
    }
  },
  "references": [
    "../ref/interactive-intake.md",
    "../ref/paper-template.md",
    "../ref/citation-style.md",
    "../ref/source-priority.md",
    "../ref/quality-checklist.md",
    "../ref/cv-latex-guide.md"
  ]
}
